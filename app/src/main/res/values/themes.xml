<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TrocCampus.Main" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/troc_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.TrocCampus" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/troc_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/troc_emerald</item>
        <item name="postSplashScreenTheme">@style/Theme.TrocCampus.Main</item>
    </style>
</resources>
